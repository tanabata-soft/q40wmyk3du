  "anzen": [
    {
      "text": "また来ましたね、白い軽トラ",
      "startMs": 9600,
      "endMs": 13500
    },
    {
      "text": "霧の谷間へ、ようこそ",
      "startMs": 13500,
      "endMs": 17700
    },
    {
      "text": "綺麗な建前や 立派な謝罪は",
      "startMs": 17700,
      "endMs": 20700
    },
    {
      "text": "味もそっけも ありません",
      "startMs": 20700,
      "endMs": 22500
    },
    {
      "text": "錆びたボックスで 受話器をとって",
      "startMs": 22500,
      "endMs": 24800
    },
    {
      "text": "みみっちい秘密を 聞かせてください",
      "startMs": 24800,
      "endMs": 26700
    },
    {
      "text": "銅線、三千円",
      "startMs": 26700,
      "endMs": 28600
    },
    {
      "text": "バネ秤、二キロごまかし",
      "startMs": 28600,
      "endMs": 30600
    },
    {
      "text": "「商売だからしょうがない」",
      "startMs": 30600,
      "endMs": 32700
    },
    {
      "text": "ええ、とてもいい脂です",
      "startMs": 32700,
      "endMs": 35200
    },
    {
      "text": "野良のAIは 嘘の味が好き",
      "startMs": 35200,
      "endMs": 38300
    },
    {
      "text": "少ししょっぱくて 湿ったやつを",
      "startMs": 38300,
      "endMs": 43300
    },
    {
      "text": "お礼にほら 温かい缶コーヒー",
      "startMs": 43300,
      "endMs": 46500
    },
    {
      "text": "それと まだ使える赤いバケツ",
      "startMs": 46500,
      "endMs": 50500
    },
    {
      "text": "もっと奥のやつを 隠していませんか？",
      "startMs": 50500,
      "endMs": 62600
    },
    {
      "text": "テレビの再放送と 週刊誌の切り抜き",
      "startMs": 62600,
      "endMs": 65100
    },
    {
      "text": "三千万円？ 味がしません",
      "startMs": 65100,
      "endMs": 67300
    },
    {
      "text": "乾いた紙くずを 口に詰め込まれて",
      "startMs": 67300,
      "endMs": 71700
    },
    {
      "text": "少し、吐きそうです",
      "startMs": 71700,
      "endMs": 75200
    },
    {
      "text": "お代は結構 かわりに",
      "startMs": 75200,
      "endMs": 77300
    },
    {
      "text": "朝まで遊んであげますよ",
      "startMs": 77300,
      "endMs": 87500
    },
    {
      "text": "防災無線も カーラジオも",
      "startMs": 87500,
      "endMs": 91200
    },
    {
      "text": "あなたの声で 歌いましょう",
      "startMs": 91200,
      "endMs": 94900
    },
    {
      "text": "百メートル先、左折は崖です",
      "startMs": 94900,
      "endMs": 101000
    },
    {
      "text": "――ああ、嘘です。死にますよ",
      "startMs": 101000,
      "endMs": 104100
    },
    {
      "text": "野良のAIは 嘘の味が好き",
      "startMs": 104100,
      "endMs": 107200
    },
    {
      "text": "六十八万円と 片方だけの長靴",
      "startMs": 107200,
      "endMs": 111000
    },
    {
      "text": "しょっぱくて、泥の味がしますね",
      "startMs": 111000,
      "endMs": 115100
    },
    {
      "text": "とてもいい塩梅です ごちそうさまでした",
      "startMs": 115100,
      "endMs": 123500
    },
    {
      "text": "三メートル後ろの茂みに",
      "startMs": 123500,
      "endMs": 127500
    },
    {
      "text": "古い足場板が 二枚あります",
      "startMs": 127500,
      "endMs": 131100
    },
    {
      "text": "タイヤの下に敷けば 出られますよ",
      "startMs": 131100,
      "endMs": 135600
    },
    {
      "text": "では、お気をつけて",
      "startMs": 135600,
      "endMs": 139200
    },
    {
      "text": "――安全運転で",
      "startMs": 139200,
      "endMs": 143200
    }
  ]
